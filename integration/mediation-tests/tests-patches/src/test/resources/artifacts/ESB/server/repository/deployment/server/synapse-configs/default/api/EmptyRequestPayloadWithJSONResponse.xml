<api xmlns="http://ws.apache.org/ns/synapse"
     name="EmptyRequestPayloadWithJSONResponse"
     context="/testEmptyRequestPayloadWithJSONResponse">
    <resource methods="GET POST PUT DELETE">
        <inSequence>
            <payloadFactory media-type="json">
                <format>
                    {
                    "response": {
                    "status": "Success",
                    "message": "This is a sample response.",
                    "code": "200"
                    }
                    }
                </format>
                <args/>
            </payloadFactory>
            <respond/>
        </inSequence>
        <outSequence/>
    </resource>
</api>
